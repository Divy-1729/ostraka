# This is documentation only; Ostraka reads the process environment, not .env files.
# Export one key in your terminal; never commit real credentials.
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...
# OSTRAKA_PROVIDER=openai
# OSTRAKA_MODEL=gpt-6.1-sol
# OSTRAKA_PORT=8000
# OSTRAKA_DATA_DIR=.ostraka
# Compatible endpoint:
# OSTRAKA_PROVIDER=compatible
# OSTRAKA_BASE_URL=http://localhost:11434/v1
# OSTRAKA_MODEL=your-model-id
# OSTRAKA_API_KEY=...
